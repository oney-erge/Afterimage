__pycache__/
.setup/
*.pyc
.pytest_cache/
# pytest-benchmark (a [dev] dependency) writes here; ruff self-ignores its
# own cache but pytest-benchmark does not.
.benchmarks/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/
*.npy
/tmp_nvme/
# Result checkpoints and streamed command logs are local recovery material.
# Publish completed stage JSON instead; nested campaigns write checkpoints
# below their model directory rather than directly under results/.
results/**/*.json.partial
results/cross_model_*/**/*.log
results/cross_model_*/INTERIM_RESULTS.md

# Local-only working material. Superseded planning documents and personal
# session scripts are kept on disk for traceability but stay out of the
# published repository.
docs/archive/
scripts/local/

# DFloat11Model.from_pretrained() downloads its checkpoint to a local
# directory named after the HF repo id (org/name -> org__name) in the
# process's own working directory, not the shared ~/.cache/huggingface
# snapshot cache the rest of this project's model acquisition uses -- if a
# benchmark script is ever run with this repo as its cwd (as
# scripts/run_bounded_suite.py's run_dfloat11 was during development),
# that lands a ~19 GB checkpoint directly in the working tree. Never
# commit it; the pattern is broad enough to catch any DFloat11 repo id.
DFloat11__*/
